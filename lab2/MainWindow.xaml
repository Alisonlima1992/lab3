<!-- MainWindow.xaml -->
<Window x:Class="ClickOrLoose.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickOrLoose" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="15">
                <Button x:Name="btnStart" Content="Start" Height="35" Margin="0,0,0,10"
                        Click="btnStart_Click"/>

                <TextBlock x:Name="tbStatus" Text="Ready!" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Score:" FontWeight="Bold"/>
                <TextBlock x:Name="tbScore" Text="0" FontSize="22" Margin="0,0,0,20"/>

                <TextBlock Text="Time:" FontWeight="Bold"/>
                <TextBlock x:Name="tbTime" Text="0.0s" FontSize="18" Margin="0,0,0,20"/>

                <ListBox x:Name="lbLog" Height="300" Background="White"/>
            </StackPanel>
        </Border>

        <Canvas x:Name="gameCanvas" Grid.Column="1" Background="White"
                MouseLeftButtonDown="gameCanvas_MouseLeftButtonDown"/>
    </Grid>
</Window>
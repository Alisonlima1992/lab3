<Window x:Class="ClickOrLoose.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClickOrLoose" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#E8E8E8" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
            <StackPanel Margin="15">

                <Button x:Name="btnStart" Content="Старт" Height="36" Margin="0,0,0,12"
                        Click="btnStart_Click"/>

                <TextBlock x:Name="tbStatus" Text="Готов" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Золото:" FontWeight="Bold"/>
                <TextBlock x:Name="tbScore" Text="0" FontSize="22" Margin="0,0,0,12"/>

                <TextBlock Text="Урон:" FontWeight="Bold"/>
                <TextBlock x:Name="tbDamage" Text="10" FontSize="18" Margin="0,0,0,12"/>

                <TextBlock Text="Перезарядка:" FontWeight="Bold"/>
                <TextBlock x:Name="tbCooldown" Text="0.60с" FontSize="18" Margin="0,0,0,12"/>

                <TextBlock Text="Время:" FontWeight="Bold"/>
                <TextBlock x:Name="tbTime" Text="0.0с" FontSize="16" Margin="0,0,0,15"/>

                <TextBlock Text="Здоровье врага:" FontWeight="Bold"/>
                <ProgressBar x:Name="pbEnemyHealth" Height="18" Minimum="0" Maximum="100" Value="100" Margin="0,4,0,4"/>
                <TextBlock x:Name="tbEnemyHealth" Text="100 / 100" Margin="0,0,0,15"/>

                <Button x:Name="btnUpgradeCooldown" Content="Улучшить перезарядку (40)" 
                        Height="34" Margin="0,5,0,15"
                        Click="btnUpgradeCooldown_Click"/>

                <TextBlock Text="Лог:" FontWeight="Bold" Margin="0,0,0,5"/>
                <ListBox x:Name="lbLog" Height="220" Background="White"/>
            </StackPanel>
        </Border>

        <Canvas x:Name="gameCanvas" Grid.Column="1" Background="White"
                MouseLeftButtonDown="gameCanvas_MouseLeftButtonDown"/>
    </Grid>
</Window>